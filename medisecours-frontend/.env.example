# Server-only URL used by the Next.js rewrite. Do not prefix it with
# NEXT_PUBLIC_ in Vercel.
API_BASE_URL=https://medisecours-backend.onrender.com

# Browser-visible values.
NEXT_PUBLIC_WS_URL=wss://medisecours-websocket.onrender.com/ws
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Optional for local development only. Leave unset on Vercel so browser API
# and media requests remain same-origin through /api.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
