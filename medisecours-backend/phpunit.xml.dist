<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="MediSecours Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <php>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="KERNEL_CLASS" value="App\Kernel"/>
        <server name="DEFAULT_URI" value="http://localhost"/>
        <server name="DATABASE_URL" value="postgresql://postgres:albert123@127.0.0.1:5432/medisecours_db?serverVersion=18&amp;charset=utf8"/>
        <server name="CORS_ALLOW_ORIGIN" value="^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$"/>
        <server name="GOOGLE_CLIENT_ID" value="test-google-client-id"/>
        <server name="GOOGLE_CLIENT_SECRET" value="test-google-client-secret"/>
        <server name="JWT_SECRET_KEY" value="%kernel.project_dir%/config/jwt/private.pem"/>
        <server name="JWT_PUBLIC_KEY" value="%kernel.project_dir%/config/jwt/public.pem"/>
        <server name="JWT_PASSPHRASE" value="916920f72e81bd2c31d27e20d394eacfb741daccfb4f27f79f5db74a3e589132"/>
        <server name="JWT_TTL" value="3600"/>
        <server name="MAILER_DSN" value="null://null"/>
        <server name="MAILER_SENDER_EMAIL" value="noreply@test.medisecours.cm"/>
        <server name="MAILER_SENDER_NAME" value="MediSecours+ Test"/>
        <server name="FRONTEND_URL" value="http://localhost:3000"/>
    </php>
</phpunit>
