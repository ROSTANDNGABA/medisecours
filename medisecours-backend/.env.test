# Variables d'environnement spécifiques à l'environnement de test.
# Ce fichier peut être commité (ne contient pas de secrets réels).
# Les valeurs sensibles réelles doivent être dans .env.test.local (non commité).

APP_ENV=test

# Mailer désactivé en test — aucun email réel envoyé
MAILER_DSN=null://null
MAILER_SENDER_EMAIL=noreply@test.medisecours.cm
MAILER_SENDER_NAME="MediSecours+ Test"

# URL frontend en test
FRONTEND_URL=http://localhost:3000

# Google OAuth — pas de vraie vérification en test
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
