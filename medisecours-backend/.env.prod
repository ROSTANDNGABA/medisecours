###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_ME_TO_A_UNIQUE_SECRET_64_CHARS_MIN
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://medisecours.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# À remplacer par votre base de production
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/medisecours_db?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Domaine du frontend en production
CORS_ALLOW_ORIGIN='^https?://(medisecours\.com|www\.medisecours\.com)$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
# Générer des clés RSA de production :
#   openssl genpkey -algorithm RSA -out config/jwt/private.pem -aes256 -pass pass:VOTRE_PASSPHRASE
#   openssl pkey -in config/jwt/private.pem -passin pass:VOTRE_PASSPHRASE -out config/jwt/public.pem -pubout
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME
JWT_TTL=28800
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
# Utiliser un service SMTP professionnel (SendGrid, Mailgun, etc.) en production
# Exemple SendGrid : MAILER_DSN=sendgrid+smtp://USERNAME:PASSWORD@default
MAILER_DSN=sendgrid+smtp://CHANGE_ME:CHANGE_ME@default
MAILER_SENDER_EMAIL=noreply@medisecours.com
MAILER_SENDER_NAME="MediSecours"
FRONTEND_URL=https://medisecours.com
###< symfony/mailer ###

###> storage (S3) ###
# Installer le package : composer require league/flysystem-aws-s3-v3
# Puis décommenter et renseigner :
# AWS_KEY=
# AWS_SECRET=
# AWS_BUCKET=medisecours-uploads
# AWS_REGION=eu-west-3
###< storage (S3) ###
